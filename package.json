{
  "name": "ghw-auth0-veto-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Veto Agent: GitHub automation with Auth0 Token Vault and CIBA out-of-band approval",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "veto": "./dist/cli.js"
  },
  "scripts": {
    "veto": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:approval": "tsx scripts/demo-approval.ts"
  },
  "dependencies": {
    "@auth0/ai": "^6.0.2",
    "auth0": "^4.37.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
