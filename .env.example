# Auth0 tenant for this challenge. Do not put real secrets in this file.
AUTH0_DOMAIN=dev-wvxvhbnjrgvgn26x.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# API that the CIBA grant requests. Create the github:mutate permission on this API.
AUTH0_AUDIENCE=https://veto-agent.example/github
AUTH0_CIBA_SCOPE=openid github:mutate

# Auth0 user who receives the Guardian push or CIBA email (the "sub" claim).
AUTH0_USER_ID=auth0|your-user-id

# Auth0 refresh token for that user. Token Vault exchanges it for a GitHub access token.
# Enable the refresh token grant and turn refresh-token rotation OFF.
AUTH0_REFRESH_TOKEN=your-auth0-refresh-token

# Token Vault connection name. GitHub's social connection is "github".
GITHUB_CONNECTION=github

# <=300 selects Auth0 Guardian push. 301-259200 selects CIBA email.
CIBA_REQUESTED_EXPIRY=120

# Set to 1 only after the API is configured for Rich Authorization Requests.
CIBA_USE_RAR=0

# Mock the CIBA /bc-authorize + /oauth/token poll (no Auth0 credentials required).
MOCK_CIBA=1
# Mock GitHub and the Token Vault exchange (no GitHub credentials required).
MOCK_GITHUB=1

# Shared directory for mock CIBA server coordinates and mock GitHub state.
CIBA_STATE_DIR=.veto-runtime

# Optional. Mock server poll interval in seconds. Live Auth0 returns its own interval.
CIBA_POLL_INTERVAL_SEC=0.5

# Optional override for the GitHub API origin.
GITHUB_API_BASE=https://api.github.com

# Callback used by `veto login` to collect an Auth0 refresh token.
AUTH0_REDIRECT_URI=http://127.0.0.1:3456/callback
